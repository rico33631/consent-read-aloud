# Copy to .env and fill in. Never commit .env.

# Your ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# Voice IDs. Both default to "George" (JBFqnCBsd6RMkjVDRZzb), a default ElevenLabs voice.
# eleven_multilingual_v2 speaks German with any voice, but a native German voice sounds better.
# Find IDs in the ElevenLabs Voice Library or via GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID_DE=
ELEVENLABS_VOICE_ID_EN=

# Optional
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_TIMEOUT_MS=30000

# Set to 1 to skip the real API and serve a short silent MP3 (no key needed).
ELEVENLABS_MOCK=0

PORT=3000
