{
  "name": "consent-read-aloud",
  "version": "0.1.0",
  "description": "Reads veterinary consent forms aloud in German or English with ElevenLabs text-to-speech, caching audio per form version.",
  "license": "MIT",
  "author": "Hrigdev Singh",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
